<?xml version="1.0" encoding="utf-8"?>
<!-- اطلاعات مالی کاربر در پشتیبان ابری خودکار اندروید یا انتقال دستگاه به دستگاه ذخیره نمی‌شود؛
     کاربر از «تهیهٔ نسخهٔ پشتیبان» داخل برنامه استفاده می‌کند. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
